{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*.mjs", "src/**/*.d.mts", "build.mjs", "test/**/*.mjs", "test/**/*.mts"]
}
