{
  "name": "komga-metadata-userscript",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:live": "node scripts/live.mjs",
    "test:release": "node --test scripts/test/*.test.mjs",
    "package:release": "python3 scripts/package_release.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
